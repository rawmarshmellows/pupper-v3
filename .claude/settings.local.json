{
  "permissions": {
    "allow": [
      "Skill(update-quick-context)",
      "Skill(fact-check)",
      "Skill(ascii-fixer)",
      "Bash(git lfs:*)",
      "WebSearch",
      "Bash(find /Users/kevinlu/Documents/Learning/pupper-v3 -type f -name \"*.py\" ! -path \"*/node_modules/*\" ! -path \"*/.git/*\" -exec grep -l \"GPIO\\\\|SPI\\\\|I2C\\\\|UART\\\\|CAN\\\\|pin\\\\|Pin\" {} \\\\;)",
      "Bash(find:*)",
      "Bash(python3 -c ':*)",
      "Bash(open:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Skill(quick-context)",
        "hooks": [
          {
            "type": "command",
            "command": "echo '[POST-PROCESS REQUIRED] Run /fact-check and /ascii-fixer on the output file'"
          }
        ]
      },
      {
        "matcher": "Skill(micro-context)",
        "hooks": [
          {
            "type": "command",
            "command": "echo '[POST-PROCESS REQUIRED] Run /fact-check and /ascii-fixer on the output file'"
          }
        ]
      },
      {
        "matcher": "Skill(small-context)",
        "hooks": [
          {
            "type": "command",
            "command": "echo '[POST-PROCESS REQUIRED] Run /fact-check and /ascii-fixer on the output file'"
          }
        ]
      }
    ]
  }
}
